<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GameSpineTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GameSpineTool"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="GameSpineTool"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False" />

        <Button
            x:Name="HistoryButton"
            Grid.Row="0"
            Margin="0,0,140,0"
            Padding="12,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="历史">
            <Button.Flyout>
                <Flyout x:Name="HistoryFlyout" Opening="HistoryFlyout_Opening" Placement="Bottom">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MaxWidth" Value="660" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <Grid Width="640" Height="420">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListView
                            x:Name="HistoryList"
                            Grid.Column="0"
                            Padding="8"
                            BorderBrush="{ThemeResource PanelBorderBrush}"
                            BorderThickness="0,0,1,0"
                            SelectionChanged="HistoryList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,8" Spacing="2">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Title}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            x:Name="HistoryEmpty"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="暂无运行记录" />

                        <Grid x:Name="HistoryDetail" Grid.Column="1" Padding="16" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <Grid Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="HistorySuccessDot"
                                        Width="8"
                                        Height="8"
                                        Fill="{ThemeResource RunSuccessBrush}" />
                                    <Ellipse
                                        x:Name="HistoryFailDot"
                                        Width="8"
                                        Height="8"
                                        Fill="{ThemeResource RunCriticalBrush}"
                                        Visibility="Collapsed" />
                                </Grid>
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="运行详情" />
                            </StackPanel>

                            <TextBlock
                                x:Name="HistoryMeta"
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="HistoryPhases"
                                Grid.Row="2"
                                Margin="0,8,0,0"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />

                            <ScrollViewer Grid.Row="3" Margin="0,12,0,0" Padding="8" Background="{ThemeResource PanelFillBrush}">
                                <TextBlock
                                    x:Name="HistoryLog"
                                    FontFamily="Consolas"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>

                            <StackPanel
                                Grid.Row="4"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    x:Name="HistoryErrors"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <Button Click="CopyHistoryLogButton_Click" Content="复制日志" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>

        <Grid Grid.Row="1" Margin="20,8,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Margin="0,0,8,0"
                Padding="16"
                Background="{ThemeResource PanelFillBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="整理资源" />

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="游戏" />
                        <ComboBox x:Name="GameComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="Echocalypse · 绯色回响 · 国际服" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="输出目录" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="OutputTextBox"
                                PlaceholderText="选择资源输出目录" />
                            <Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Click="BrowseButton_Click"
                                Content="浏览" />
                        </Grid>

                        <ToggleSwitch
                            x:Name="UpscaleSwitch"
                            Header="2倍超分"
                            OffContent="关闭"
                            OnContent="开启" />
                    </StackPanel>

                    <Button
                        x:Name="StartButton"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Click="StartButton_Click"
                        Content="开始整理"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Margin="8,0,0,8"
                Padding="16"
                Background="{ThemeResource PanelFillBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="当前阶段" />
                    <TextBlock x:Name="StageText" Text="等待开始" />
                    <ProgressBar x:Name="StageProgress" Maximum="100" Minimum="0" Value="0" />
                    <TextBlock
                        x:Name="StageDetail"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="1"
                Grid.Column="1"
                Margin="8,8,0,0"
                Padding="16"
                Background="{ThemeResource PanelFillBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="运行日志" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Click="CopyLogButton_Click"
                            Content="复制日志" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock
                            x:Name="LogText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="尚无记录"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
